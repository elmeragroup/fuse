{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import", "unicorn"],
  "jsPlugins": [
    "eslint-plugin-turbo",
    "@shadcn/lint",
    {
      "name": "elmera",
      "specifier": "@elmeragroup/internal/oxlint"
    },
    {
      "name": "anti-slop",
      "specifier": "@elmeragroup/internal/oxlint/anti-slop"
    },
    {
      "name": "fuse",
      "specifier": "./tooling/oxlint-plugin-fuse/src/plugin.ts"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "turbo/no-undeclared-env-vars": "error",
    "fuse/require-disable-reason": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-unnecessary-parameter-property-assignment": "off",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/no-unnecessary-condition": [
      "error",
      {
        "allowConstantLoopConditions": true
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/dot-notation": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-regexp-exec": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-empty-function": "error",
    "typescript/require-await": "error",
    "typescript/promise-function-async": "off",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unused-expressions": "error",
    "typescript/consistent-type-definitions": ["warn", "type"],
    "typescript/consistent-type-imports": [
      "warn",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/array-type": "off",
    "typescript/ban-types": "off",
    "typescript/prefer-readonly": "off",
    "typescript/no-duplicate-enum-values": "off",
    "typescript/no-misused-spread": "error",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/require-array-sort-compare": "error",
    "no-constant-binary-expression": "error",
    "typescript/no-redundant-type-constituents": "error",
    "import/consistent-type-specifier-style": ["warn", "prefer-top-level"],
    "import/no-cycle": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase",
        "ignore": ["^[a-z]{2}-[A-Z]{2}\\."]
      }
    ],
    "unicorn/no-await-in-promise-methods": "off",
    "unicorn/no-empty-file": "off",
    "unicorn/no-invalid-fetch-options": "off",
    "unicorn/no-invalid-remove-event-listener": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-single-promise-in-promise-methods": "off",
    "unicorn/no-thenable": "off",
    "unicorn/no-unnecessary-await": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-useless-length-check": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/prefer-set-size": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "warn",
    "anti-slop/no-runtime-typeof": "warn",
    "anti-slop/no-shape-in-symbol-names": "warn",
    "anti-slop/no-slop-comments": [
      "warn",
      {
        "ticketPattern": "ELM-\\d+"
      }
    ],
    "anti-slop/no-narration-comments": "warn"
  },
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "19"
    },
    "shadcn": {
      "ui": "@elmeragroup/fuse",
      "ignoreImports": [
        "^@elmeragroup/fuse/(icons|emoji|illustrations|flags|theme)(/|$)",
        "^@elmeragroup/fuse/react-aria/ui-providers$"
      ],
      "mergeFunctions": ["mergeClassName"]
    }
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.next/**",
    "apps/docs/src/generated/**",
    "plop-templates/**",
    "**/.artifacts/**",
    "**/.cache/**",
    "**/node_modules/**",
    ".ref/**",
    "packages/fuse/scripts/*.mjs",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**"
  ],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": ["apps/**/*.{ts,tsx}", "packages/fuse/**/*.{ts,tsx}"],
      "globals": {
        "React": "writable"
      },
      "plugins": ["typescript", "oxc", "react", "unicorn", "jsx-a11y"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/no-children-prop": "off",
        "react/exhaustive-deps": "error",
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "error",
        "react/no-unstable-nested-components": "error",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/heading-has-content": "off",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/aria-proptypes": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-aria-hidden-on-focusable": "off",
        "jsx-a11y/img-redundant-alt": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/aria-role": "off",
        "jsx-a11y/anchor-is-valid": "off"
      }
    },
    {
      "files": ["packages/fuse/src/**/*.{ts,tsx}"],
      "rules": {
        "elmera/no-primitive-colors": "error",
        "elmera/no-tailwind-dark-variant": "error",
        "elmera/enforce-variant-standard": "error",
        "elmera/no-local-focus-ring": "error",
        "elmera/restrict-focus-ring-call": "error",
        "elmera/restrict-browser-helper-copy": "error",
        "elmera/no-field-part-jsx": "error",
        "elmera/require-icon-button-label": "error",
        "elmera/restrict-process-env": "error",
        "elmera/no-internal-dynamic-import": "error",
        "elmera/facade-reexport-grammar": "error",
        "elmera/no-rac-outside-quarantine": "error",
        "elmera/no-hardcoded-density-metrics": "warn",
        "elmera/no-raw-class-map": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@internationalized/string",
                "importNames": ["LocalizedStringDictionary"],
                "allowTypeImports": true,
                "message": "Assemble dictionaries with createStringDictionary; do not construct LocalizedStringDictionary outside the factory."
              },
              {
                "name": "@tanstack/react-table",
                "allowTypeImports": true,
                "message": "Import only types from the optional TanStack peer. Plain parts render through table.FlexRender and read structural slices; only the data-table contexts, the table hook factory and their tests call into TanStack."
              },
              {
                "name": "@tanstack/react-virtual",
                "allowTypeImports": true,
                "message": "Import only types from the optional virtualizer peer. Only the command-virtual list calls into TanStack Virtual, so the core command entry never loads it."
              },
              {
                "name": "@base-ui/react/combobox",
                "allowTypeImports": true,
                "message": "Import Combobox from the @base-ui/react package root. The subpath type-checks but crashes at runtime with a null React context."
              },
              {
                "name": "@base-ui/react/autocomplete",
                "allowTypeImports": true,
                "message": "Import Autocomplete from the @base-ui/react package root. It shares the combobox internals, so the subpath type-checks but crashes at runtime with a null React context."
              },
              {
                "name": "tailwind-variants",
                "importNames": ["tv", "createTV"],
                "allowTypeImports": true,
                "message": "Import tv from styles/tv. It shares cn's tailwind-merge extension, so a consumer's rounded-* class replaces rounded-inner in a recipe; the upstream tv keeps both."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/docs/src/**/*.{ts,tsx}"],
      "rules": {
        "elmera/no-primitive-colors": "error",
        "elmera/no-raw-class-map": "error"
      }
    },
    {
      "files": ["apps/docs/src/**/*.{ts,tsx}", "apps/static-theme/src/**/*.{ts,tsx}"],
      "rules": {
        "shadcn/no-raw-colors": "error",
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": ["error", { "allow": ["not-prose"] }]
      }
    },
    {
      "files": ["apps/docs/src/og/**/*.{ts,tsx}", "apps/docs/src/app/og/**/*.{ts,tsx}"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    {
      "files": ["packages/fuse/src/**/*.{ts,tsx}"],
      "rules": {
        "shadcn/no-raw-colors": "error",
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": "error"
      }
    },
    {
      "files": ["packages/fuse/src/react-aria/grid-list/grid-list.tsx"],
      "rules": {
        "shadcn/no-inline-styles": ["error", { "allow": ["pointerEvents"] }]
      }
    },
    {
      "files": [
        "packages/fuse/src/icons/**",
        "packages/fuse/src/illustrations/**",
        "packages/fuse/src/components/emoji/**"
      ],
      "rules": {
        "shadcn/no-raw-colors": "off",
        "shadcn/no-inline-styles": ["error", { "allow": ["maskType"] }]
      }
    },
    {
      "files": ["apps/docs/src/**/*.{ts,tsx}"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"],
            "contracts": [
              {
                "pattern": "^Collapsible(Trigger|Content)$",
                "allow": ["layout", "color", "typography", "spacing", "shape", "effects", "motion"],
                "message": "Collapsible is a headless passthrough (collapsible.tsx) apart from Content's height transition; style it freely or render a Button via `render`."
              },
              {
                "pattern": "^Card(Content|Header|Footer)$|^Dialog(Header|Footer)$|^Field(Root|Item|Set)$",
                "allow": ["layout", "spacing"]
              },
              {
                "pattern": "^Skeleton$",
                "allow": ["layout", "rounded"],
                "message": "Skeleton is a shape-only placeholder: size and radius are yours, colour and motion are its own."
              },
              {
                "pattern": "^ScrollAreaRoot$",
                "allow": ["layout", "rounded", "border-w", "border-color"]
              }
            ]
          }
        ],
        "shadcn/no-arbitrary-values": ["error", { "allow": ["layout", "rounded-[inherit]"] }]
      }
    },
    {
      "files": ["apps/docs/src/components/docs-inline-code.tsx"],
      "rules": {
        "shadcn/no-arbitrary-values": ["error", { "allow": ["py-[0.1em]", "px-[0.35em]"] }]
      }
    },
    {
      "files": ["apps/docs/src/components/token-swatch-list.tsx"],
      "rules": {
        "shadcn/no-arbitrary-values": [
          "error",
          {
            "allow": [
              "layout",
              "bg-[repeating-linear-gradient(45deg,transparent,transparent_3px,color-mix(in_oklab,var(--foreground)_14%,transparent)_3px,color-mix(in_oklab,var(--foreground)_14%,transparent)_6px)]"
            ]
          }
        ],
        "shadcn/no-inline-styles": ["error", { "allow": ["backgroundColor"] }]
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.test-d.{ts,tsx}"],
      "rules": {
        "shadcn/no-inline-styles": "off",
        "shadcn/no-unknown-classes": "off",
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off"
      }
    },
    {
      "files": ["packages/fuse/test/**/*.{ts,tsx}"],
      "rules": {
        "elmera/restrict-browser-helper-copy": "error"
      }
    },
    {
      "files": ["packages/fuse/scripts/**"],
      "rules": {
        "elmera/restrict-package-root-from-script": "error"
      }
    },
    {
      "files": ["packages/fuse/src/styles/tv.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
