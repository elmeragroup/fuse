        "packages/fuse/src/components/data-table/create-fuse-table-hook.ts",
        "packages/fuse/src/components/data-table/*.test*.{ts,tsx}",
        "packages/fuse/src/components/data-table-filter/*.test*.{ts,tsx}"
      ],
      "rules": {
