{
  "extends": ["//"],
  "tasks": {
    // The docs pipeline writes src/generated and public/components before anything
    // reads them. It is its own task so turbo orders it ahead of build, type-check and
    // the root lint, instead of a build script racing them for the same files.
    "generate": {
      "dependsOn": ["^build"],
      // The Tokens page publishes the library's own recorded measurements, so a budget
      // recalibration must invalidate this task even though nothing in apps/docs moved.
      "inputs": ["$TURBO_DEFAULT$", "../../packages/ui/scripts/size-budgets.ts"],
      "outputs": ["src/generated/**", "public/components/**", "public/llms.txt"]
    },
    "build": {
      "dependsOn": ["generate"]
    },
    "type-check": {
      "dependsOn": ["generate"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["DOCS_BASE_URL"]
    }
  }
}
