{
  "extends": ["//"],
  "tasks": {
    // The docs pipeline writes src/generated and the markdown endpoints under public before anything
    // reads them. It is its own task so turbo orders it ahead of build, type-check and
    // the root lint, instead of a build script racing them for the same files.
    "generate": {
      "dependsOn": ["^build"],
      // The studio's slot index reads slots through the lint plugin's slot scanner, so an edit to
      // any of the plugin's sources must invalidate this task even though nothing in apps/docs
      // moved. The whole source tree, not the scanner's imports listed by hand, so a new import
      // cannot fall out of the list.
      // The catalog schema has no build task for `^build` to key on, and this task writes
      // src/generated/catalog.json through it, so its source is an input too.
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tooling/oxlint-plugin-fuse/src/**/*.ts",
        "!../../tooling/oxlint-plugin-fuse/src/**/*.test.ts",
        "../../packages/docs-catalog/src/**/*.ts"
      ],
      // The committed per-component api.json, and each extra entry's <entry>.api.json beside it,
      // are outputs too. They are tracked, unlike everything else here, but this task is what
      // writes them — so a cache hit has to restore them, or the drift check would read a file
      // this run never produced.
      "outputs": [
        "src/generated/**",
        "src/app/\\(docs\\)/components/*/api.json",
        "src/app/\\(docs\\)/components/*/*.api.json",
        "public/**/*.md",
        "public/llms.txt"
      ]
    },
    // A cache hit on `generate` restores the current twins under public but leaves a twin an earlier
    // run wrote for a since renamed route, which Next would serve. This uncached task removes every
    // markdown file there that src/generated/catalog.json names no twin for, before Next builds or
    // serves. The `start` script runs the same script before `next start`.
    "reconcile-markdown": {
      "dependsOn": ["generate"],
      "cache": false
    },
    // `dev` waits for generation and for the markdown reconcile, so Next serves no stale twin. The
    // dev script generates on its own only when turbo did not start it (turbo sets TURBO_HASH for
    // every task), so `pnpm --filter docs dev` still generates before Next starts.
    "dev": {
      "dependsOn": ["^build", "generate", "reconcile-markdown"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["generate", "reconcile-markdown"],
      // A replay needs the compiled app, not Next's build cache or a local `next dev` cache;
      // archiving those put about 3.9 GB into every local docs#build cache entry.
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      // Strict env mode hides undeclared variables from the build. The origin, or the PORT its
      // localhost fallback names, is baked into every prerendered og:image URL
      // (src/lib/site-origin.ts), so both key the cache.
      "env": ["DOCS_ORIGIN", "PORT"]
    },
    // The build the e2e suite serves: `build` prerendered in New York, without the standalone bundle.
    // Its script sets DOCS_E2E_BUILD, which moves its output to .cache/next-e2e (next.config.ts), so `.next`
    // stays the production build the unit suite asserts on. Only this task declares the variable:
    // strict env mode hides it from `build`, which the container image runs.
    "build:e2e": {
      "dependsOn": ["generate", "reconcile-markdown"],
      "outputs": [".cache/next-e2e/**", "!.cache/next-e2e/cache/**", "!.cache/next-e2e/dev/**"],
      "env": ["DOCS_ORIGIN", "PORT", "DOCS_E2E_BUILD"]
    },
    // `next build` deletes everything in .next except cache/dev/lock/trace before it
    // compiles, while `next typegen` creates .next/types and then writes into it. Running
    // both at once lets the build's clean land between those two steps, failing typegen
    // with ENOENT on routes.d.ts (merge run 34702372072). Order type-check after build.
    "type-check": {
      "dependsOn": ["generate", "build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    // Docs has no browser, pack or packed-consumer script. The CI browser job runs these tasks
    // across the repo, and without these overrides turbo would build docs for no-op tasks.
    "test:browser": {
      "dependsOn": []
    },
    "test:packed-consumer": {
      "dependsOn": []
    },
    // DOCS_E2E_SITE=skip leaves out the studio and landing files (vitest.config.ts), so it keys
    // the cache: a skipped run must not replay for a full one.
    "test:e2e": {
      "dependsOn": ["build:e2e"],
      "env": ["DOCS_E2E_SITE"]
    }
  }
}
