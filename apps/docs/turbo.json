{
  "extends": ["//"],
  "tasks": {
    // The docs pipeline writes src/generated and public/components before anything
    // reads them. It is its own task so turbo orders it ahead of build, type-check and
    // the root lint, instead of a build script racing them for the same files.
    "generate": {
      "dependsOn": ["^build"],
      // The Tokens page publishes the library's own recorded measurements, so a budget
      // recalibration must invalidate this task even though nothing in apps/docs moved. The
      // studio's slot index reads slots through Fuse's private scanner, which counts the same.
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/fuse/scripts/size-budgets.ts",
        "../../packages/fuse/test/written-slots.ts"
      ],
      // The committed per-component api.json is an output too. It is tracked, unlike
      // everything else here, but this task is what writes it — so a cache hit has to
      // restore it, or the drift check would read a file this run never produced.
      "outputs": [
        "src/generated/**",
        "src/app/\\(docs\\)/components/*/api.json",
        "public/components/**",
        "public/llms.txt"
      ]
    },
    "build": {
      "dependsOn": ["generate"],
      // A replay needs the compiled app, not Next's build cache or a local `next dev` cache;
      // archiving those put about 3.9 GB into every local docs#build cache entry.
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      // Strict env mode hides undeclared variables from the build. The origin, or the PORT its
      // localhost fallback names, is baked into every prerendered og:image URL
      // (src/lib/site-origin.ts), so both key the cache.
      "env": ["DOCS_ORIGIN", "PORT"]
    },
    // The build the e2e suite serves: `build` plus Next's Instant Navigation testing API, which
    // `instant()` needs (test/instant-navigation.browser.test.ts). Its script sets
    // DOCS_TESTING_API, which also moves its output to .cache/next-e2e (next.config.ts), so `.next`
    // stays the production build the unit suite asserts on. Only this task declares the variable:
    // strict env mode hides it from `build`, which the container image runs.
    "build:e2e": {
      "dependsOn": ["generate"],
      "outputs": [".cache/next-e2e/**", "!.cache/next-e2e/cache/**", "!.cache/next-e2e/dev/**"],
      "env": ["DOCS_ORIGIN", "PORT", "DOCS_TESTING_API"]
    },
    // `next build` deletes everything in .next except cache/dev/lock/trace before it
    // compiles, while `next typegen` creates .next/types and then writes into it. Running
    // both at once lets the build's clean land between those two steps, failing typegen
    // with ENOENT on routes.d.ts (merge run 34702372072). Order type-check after build.
    "type-check": {
      "dependsOn": ["generate", "build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:e2e": {
      "dependsOn": ["build:e2e"]
    }
  }
}
