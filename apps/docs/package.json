{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run generate && next build",
    "ci:checks": "true",
    "dev": "pnpm run generate && next dev --port 3000",
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "start": "next start --port 3000",
    "test": "vitest run",
    "type-check": "pnpm run generate && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@elmeragroup/ui": "workspace:*",
    "@next/mdx": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@elmeragroup/typescript-config": "workspace:*",
    "@mdx-js/loader": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "sugar-high": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
