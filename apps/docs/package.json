{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:e2e": "DOCS_TESTING_API=1 next build",
    "dev": "pnpm run generate && next dev --port 3000",
    "generate": "node --experimental-strip-types --experimental-transform-types --import ../../packages/fuse/scripts/ts-resolve.mjs scripts/generate.ts",
    "start": "next start --port 3000",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project browser",
    "type-check": "next typegen && tsc --noEmit"
  },
