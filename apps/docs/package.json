{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:e2e": "TZ=America/New_York DOCS_E2E_BUILD=1 next build",
    "dev": "([ -n \"$TURBO_HASH\" ] || pnpm run generate) && next dev --port 3000",
    "generate": "node --import ../../packages/fuse/scripts/ts-resolve.mjs scripts/generate.ts",
    "reconcile-markdown": "node --import ../../packages/fuse/scripts/ts-resolve.mjs scripts/reconcile-markdown.ts",
    "start": "pnpm run reconcile-markdown && next start --port 3000",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project browser",
    "type-check": "next typegen && tsrs --noEmit && tsrs --noEmit -p tsconfig.node.json",
    "live-code:sweep": "vitest run --config scripts/live-code-sweep/vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@elmeragroup/fuse": "workspace:*",
    "@fontsource/inter": "catalog:",
    "@fontsource/roboto": "catalog:",
    "@next/mdx": "catalog:",
    "@paper-design/shaders-react": "catalog:",
    "@shuding/opentype.js": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "libphonenumber-js": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@elmeragroup/color": "workspace:*",
    "@elmeragroup/docs-catalog": "workspace:*",
    "@elmeragroup/internal": "catalog:",
    "@elmeragroup/typescript-config": "workspace:*",
    "@mdx-js/loader": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "jsonc-parser": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "mdast-util-mdx": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "micromark-extension-mdxjs": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-transform": "catalog:",
    "picomatch": "catalog:",
    "playwright": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "sugar-high": "catalog:",
    "tailwindcss": "catalog:",
    "temporal-polyfill": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
