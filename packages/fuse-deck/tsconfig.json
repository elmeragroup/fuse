{
  "extends": "@elmeragroup/typescript-config/base.json",
  "compilerOptions": {
    // The command line and the bundler run in Node: no DOM types.
    "lib": ["ESNext"],
    // `node` runs the CLI from source by stripping types, which cannot run enums or parameter
    // properties.
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true
  },
  "include": ["src", "tsdown.config.ts", "vitest.config.ts"],
  // The browser runtime has tsconfig.runtime.json, and the tests tsconfig.test.json.
  "exclude": ["src/runtime"]
}
