{
  "name": "@elmeragroup/color",
  "version": "0.0.0",
  "private": true,
  "description": "Color parsing, conversion, mixing and contrast for the Fuse workspace. A dependency-free core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./css-color": {
      "types": "./src/css-color.ts",
      "import": "./src/css-color.ts"
    },
    "./cvd": {
      "types": "./src/cvd.ts",
      "import": "./src/cvd.ts"
    },
    "./hex": {
      "types": "./src/hex.ts",
      "import": "./src/hex.ts"
    },
    "./oklab": {
      "types": "./src/oklab.ts",
      "import": "./src/oklab.ts"
    },
    "./oklch": {
      "types": "./src/oklch.ts",
      "import": "./src/oklch.ts"
    },
    "./result": {
      "types": "./src/result.ts",
      "import": "./src/result.ts"
    },
    "./srgb": {
      "types": "./src/srgb.ts",
      "import": "./src/srgb.ts"
    },
    "./wcag": {
      "types": "./src/wcag.ts",
      "import": "./src/wcag.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "type-check": "tsrs --noEmit",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@elmeragroup/typescript-config": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "fast-check": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
