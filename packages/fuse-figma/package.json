{
  "name": "@elmeragroup/fuse-figma",
  "version": "0.0.0",
  "private": true,
  "description": "Syncs the Fuse design tokens into a Figma file's local variables and builds the Fuse components plugin.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "figma": "node --env-file-if-exists=.env --experimental-strip-types --import ../fuse/scripts/ts-resolve.mjs src/main.ts",
    "figma:check": "pnpm run figma check",
    "figma:plugin": "node --experimental-strip-types --import ../fuse/scripts/ts-resolve.mjs scripts/build-plugin.ts",
    "figma:sync": "pnpm run figma sync",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit -p plugin"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@elmeragroup/color": "workspace:*",
    "@elmeragroup/fuse": "workspace:*",
    "effect": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-react-aria-components": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@elmeragroup/typescript-config": "workspace:*",
    "@figma/plugin-typings": "catalog:",
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
