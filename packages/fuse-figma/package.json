{
  "name": "@elmeragroup/fuse-figma",
  "version": "0.0.0",
  "private": true,
  "description": "Syncs the Fuse design tokens into a Figma file's local variables and builds the Fuse components plugin.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "figma": "node --env-file-if-exists=.env --import ../fuse/scripts/ts-resolve.mjs src/main.ts",
    "figma:check": "pnpm run figma check",
    "figma:compare": "node --import ../fuse/scripts/ts-resolve.mjs scripts/compare.ts",
    "figma:plugin": "node --import ../fuse/scripts/ts-resolve.mjs scripts/build-plugin.ts",
    "figma:sync": "pnpm run figma sync",
    "test": "vitest run",
    "type-check": "tsrs --noEmit && tsrs --noEmit -p plugin"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@elmeragroup/color": "workspace:*",
    "@elmeragroup/fuse": "workspace:*",
    "effect": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@elmeragroup/typescript-config": "workspace:*",
    "@figma/plugin-typings": "catalog:",
    "@fontsource/roboto": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "pixelmatch": "catalog:",
    "playwright": "catalog:",
    "pngjs": "catalog:",
    "quickjs-emscripten": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rolldown": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
