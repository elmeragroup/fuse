{
  "extends": ["//"],
  "tasks": {
    // The capture check in Chromium: each capture-backed set captured again and compared with its
    // kept file, the perturbation probe, the differential oracle and the fake-file Plan differential.
    // It runs in CI's `figma-capture` job and stays out of the local `check` gate. Like
    // `test:compare`, it renders Fuse's build; the Plan differential reads the plugin's sources.
    "test:capture": {
      "dependsOn": ["@elmeragroup/fuse#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!test/**",
        "$TURBO_ROOT$/packages/color/src/**",
        "$TURBO_ROOT$/apps/docs/src/app/*/components/*/api.json"
      ]
    },
    // `figma:compare --self-check` in Chromium: every kit cell rendered twice and compared, and each
    // client cell's mounted markup checked against its definition. It takes minutes, so it runs in
    // CI's `figma-compare` job and stays out of the local `check` gate. The cells import Fuse's
    // build, whose task hash covers Fuse's sources, which the kit reads through the catalog entries
    // too. The color package has no build, so its sources are listed. The inputs leave out what the
    // run never reads, so a docs or test edit replays the cached result.
    "test:compare": {
      "dependsOn": ["@elmeragroup/fuse#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!test/**",
        "!plugin/**",
        "!**/*.test.ts",
        "$TURBO_ROOT$/packages/color/src/**"
      ]
    }
  }
}
