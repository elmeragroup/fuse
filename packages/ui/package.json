{
  "name": "@elmeragroup/ui",
  "version": "0.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "true",
    "ci:checks": "true",
    "pack": "mkdir -p .artifacts && pnpm pack --pack-destination .artifacts",
    "package:check": "true",
    "size-limit": "true",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:types": "vitest typecheck --config vitest.types.config.ts",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@elmeragroup/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
