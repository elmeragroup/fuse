{
  "name": "@elmeragroup/ui",
  "version": "0.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./css": "./src/styles/ui.css",
    "./styles.css": "./dist/styles.css",
    "./themes.css": "./dist/themes.css"
  },
  "scripts": {
    "build": "node --experimental-strip-types --experimental-transform-types --import ./scripts/ts-resolve.mjs scripts/build-css.ts",
    "ci:checks": "true",
    "pack": "mkdir -p .artifacts && pnpm pack --pack-destination .artifacts",
    "package:check": "true",
    "size-limit": "true",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:types": "vitest typecheck --config vitest.types.config.ts",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:",
    "tailwindcss-react-aria-components": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@elmeragroup/typescript-config": "workspace:*",
    "@tailwindcss/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
