{
  "name": "@elmeragroup/ui",
  "version": "0.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./button": {
      "types": "./src/button.ts",
      "import": "./src/button.ts"
    },
    "./css": "./src/styles/ui.css",
    "./icons": {
      "types": "./src/icons.ts",
      "import": "./src/icons.ts"
    },
    "./scroll-area": {
      "types": "./src/scroll-area.ts",
      "import": "./src/scroll-area.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./theme": {
      "types": "./src/theme.ts",
      "import": "./src/theme.ts"
    },
    "./themes.css": "./dist/themes.css"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "scripts": {
    "build": "node --experimental-strip-types --experimental-transform-types --import ./scripts/ts-resolve.mjs scripts/build.ts",
    "ci:checks": "true",
    "pack": "node --experimental-strip-types --experimental-transform-types --import ./scripts/ts-resolve.mjs scripts/pack.ts",
    "package:check": "node --experimental-strip-types --experimental-transform-types --import ./scripts/ts-resolve.mjs scripts/package-check.ts",
    "size-limit": "true",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:types": "vitest --config vitest.types.config.ts --typecheck.only --run",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:",
    "tailwindcss-react-aria-components": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@arethetypeswrong/core": "catalog:",
    "@elmeragroup/typescript-config": "workspace:*",
    "@tailwindcss/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
