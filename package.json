{
  "name": "fuse",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "oxfmt --check && turbo run check",
    "ci:checks": "oxfmt --check && turbo run ci:checks",
    "dev": "turbo run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen": "plop --plopfile plopfile.mjs",
    "lint": "turbo run //#lint:oxlint",
    "lint:fix": "turbo run //#lint:prerequisites && pnpm run lint:oxlint --fix",
    "lint:oxlint": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint oxlint . --deny-warnings --report-unused-disable-directives-severity=error",
    "release": "node --import ./packages/fuse/scripts/ts-resolve.mjs scripts/release.ts",
    "release:version": "pnpm exec changeset version && pnpm install --lockfile-only",
    "shots": "node --import ./packages/fuse/scripts/ts-resolve.mjs tooling/pr-shots/src/main.ts",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:e2e": "turbo run test:e2e",
    "test:repo-policy": "vitest run --config test/vitest.config.mjs",
    "test:types": "turbo run test:types",
    "turbo-cache:prune": "node scripts/prune-turbo-cache.ts .turbo/cache .turbo/runs",
    "type-check": "turbo run type-check",
    "type-check:scripts": "tsrs --noEmit -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@elmeragroup/internal": "catalog:",
    "@elmeragroup/typescript-config": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/semver": "catalog:",
    "effect": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "picomatch": "catalog:",
    "plop": "catalog:",
    "semver": "catalog:",
    "tsrs": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.20.0"
}
