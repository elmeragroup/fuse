{
  "name": "elmera-group-ui",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "ci:checks": "oxfmt --check && turbo run ci:checks",
    "dev": "turbo run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen": "plop --plopfile plopfile.mjs",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint --fix .",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:repo-policy": "vitest run --config test/vitest.config.mjs",
    "test:types": "turbo run test:types",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@elmeragroup/internal": "file:vendor/internal/elmeragroup-internal-0.1.0-canary.1.tgz",
    "@elmeragroup/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "plop": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "packageManager": "pnpm@11.20.0"
}
