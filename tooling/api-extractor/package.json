{
  "name": "@elmeragroup/api-extractor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "ci:checks": "pnpm run check:catalog && pnpm run check:boundary && pnpm run test:fixtures && pnpm run test:conformance && pnpm run test:timing && pnpm run test:timing:issue14 && pnpm run test:timing:external-selection",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "test:timing": "node scripts/issue-02-timing.ts --check",
    "test:timing:issue14": "node scripts/issue-14-timing.ts --check",
    "test:timing:external-selection": "node scripts/package-selective-external-types-timing.ts --check",
    "report:timing": "node scripts/issue-02-timing.ts --write",
    "report:timing:issue14": "node scripts/issue-14-timing.ts --write",
    "report:warnings": "node scripts/issue-14-conformance.ts --write-warnings",
    "check:catalog": "node scripts/check-fixture-catalog.ts",
    "check:boundary": "node scripts/check-boundary.ts",
    "test:fixtures": "node scripts/typecheck-fixtures.ts",
    "check:all": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run check:catalog && pnpm run check:boundary && pnpm run type-check && pnpm run test:fixtures && pnpm run test && pnpm run test:conformance && pnpm run test:timing && pnpm run test:timing:issue14 && pnpm run test:timing:external-selection",
    "test:conformance": "node scripts/issue-14-conformance.ts --check",
    "report:conformance": "node scripts/issue-14-conformance.ts --write",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@elmeragroup/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
