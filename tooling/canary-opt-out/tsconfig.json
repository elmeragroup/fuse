{
  "extends": "@elmeragroup/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    // `node` runs the sources by stripping types, which cannot run enums or parameter properties.
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src", "test", "vitest.config.ts"]
}
