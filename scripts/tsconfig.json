{
  "extends": "@elmeragroup/typescript-config/base.json",
  "compilerOptions": {
    // The release entry point imports packages/fuse/scripts/release-pack.ts, so the program root is
    // the checkout and its transitive adapter files are checked here with `["ESNext"]` only. That
    // is stricter than the Fuse package program's `["dom","dom.iterable","esnext"]` and correct for
    // Node-executed scripts. This is a type-check-only program: base.json already sets `noEmit`
    // and no incremental state is configured. Those files are deliberately checked both by this
    // program and by the Fuse package's program.
    "rootDir": "..",
    "lib": ["ESNext"]
  },
  "include": ["**/*.ts"]
}
