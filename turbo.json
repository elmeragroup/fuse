{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    // What oxlint's type-aware rules read besides the source tree; without it they resolve imports to
    // error types and report every member access on them. A task with no script, so `pnpm lint` and
    // `pnpm lint:fix` share one list. apps/static-theme/vite.config.ts must import
    // packages/fuse/dist/theme.js because colorSchemeScriptSource's Function#toString() has to be the
    // packed IIFE, not re-emitted TypeScript, and fuse-figma's compare cells import the Fuse build
    // because Node cannot load its TSX source. The docs app imports its generated src/generated.
    "//#lint:prerequisites": {
      "dependsOn": ["@elmeragroup/fuse#build", "docs#generate"]
    },
    // `pnpm lint` runs this task rather than the script itself, so the prerequisites build first.
    "//#lint:oxlint": {
      "dependsOn": ["//#lint:prerequisites"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // The policy suites read files across the workspace, so a complete input list would have
    // to enumerate every source tree. Caching this task would mean maintaining a fragile,
    // incomplete list for little gain, so it always runs.
    "//#test:repo-policy": {
      "cache": false
    },
    "//#type-check:scripts": {
      "inputs": [
        "scripts/**",
        "packages/fuse/scripts/**",
        // entries.ts imports the roster and build-css.ts imports the theme generators, so a
        // roster or theme edit must miss this task's cache.
        "packages/fuse/src/icons/roster.ts",
        "packages/fuse/src/theme/**",
        // The theme generators parse and mix colors through the color package.
        "packages/color/src/**",
        // scripts/tsconfig.json type-checks the lint config with the scripts.
        "oxlint.config.ts",
        // oxlint.config.ts imports the restricted-imports option types from the lint plugin.
        "tooling/oxlint-plugin-fuse/src/**",
        "tooling/typescript/**",
        "package.json",
        "pnpm-workspace.yaml"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    // Density-artifact tripwires assert dist output; without the Fuse build they skip silently.
    "test": {
      "dependsOn": ["@elmeragroup/fuse#build"]
    },
    "test:browser": {
      "dependsOn": ["build"]
    },
    // CI-only Playwright suites, too slow for the local `check` gate (docs against `next start`,
    // pr-shots' capture tool). Fast suites against a built host, like static-theme's first-paint
    // suite, stay in `test:browser`.
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "test:packed-consumer": {
      "dependsOn": ["pack"]
    },
    "test:types": {
      "dependsOn": ["build"]
    },
    "pack": {
      "dependsOn": ["build"],
      "outputs": [".artifacts/**"]
    },
    "package:check": {
      "dependsOn": ["pack"]
    },
    // Measures the packed tarball, so it runs after `pack`. The report is the merge workflow's PR
    // size comment input, so a cache hit restores it.
    "size-limit": {
      "dependsOn": ["pack"],
      "outputs": [".artifacts/size-report.json"]
    },
    // The chart entry's API report reads the built declarations, and a stale committed report fails.
    // `--local` rewrites the report, so the report is the task's output: a cache hit restores the
    // report that run wrote instead of replaying logs over older contents.
    "api:report": {
      "dependsOn": ["build"],
      "outputs": ["etc/chart.api.md"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // Aggregate leaves. Every real gate below is its own task, so a package's own `ci:checks` or
    // `check` script has nothing left to run: `@elmeragroup/fuse` defines both as self-describing
    // no-ops that exist only so `turbo run <aggregate>` fans out to the dependency list.
    // `check` is the local gate; `ci:checks` is `check` plus the CI-only e2e and packed-artifact
    // tier (`test:e2e`, `test:packed-consumer`, `package:check`), so it mirrors every gate the
    // merge workflow runs.
    "ci:checks": {
      "dependsOn": ["check", "test:e2e", "test:packed-consumer", "package:check"]
    },
    "check": {
      "dependsOn": [
        "//#lint:oxlint",
        "//#test:repo-policy",
        "//#type-check:scripts",
        "type-check",
        "test",
        "test:browser",
        "test:types",
        "build",
        "size-limit",
        "api:report"
      ]
    }
  }
}
