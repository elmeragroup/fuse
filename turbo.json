{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "//#lint": {
      // apps/static-theme/vite.config.ts must import packages/ui/dist/theme.js (architecture.md:
      // colorSchemeScriptSource's Function#toString() has to be the packed IIFE, not re-emitted
      // TypeScript), and import/no-cycle resolves that import — so lint needs the ui build.
      "dependsOn": ["@elmeragroup/ui#build", "docs#generate"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // The policy suites read files across the workspace, so a complete input list would have
    // to enumerate every source tree. Caching this task would mean maintaining a fragile,
    // incomplete list for little gain, so it always runs.
    "//#test:repo-policy": {
      "cache": false
    },
    "//#type-check:scripts": {
      "inputs": [
        "scripts/**",
        "packages/ui/scripts/**",
        // entries.ts imports the roster and build-css.ts imports the theme generators, so a
        // roster or theme edit must miss this task's cache.
        "packages/ui/src/icons/roster.ts",
        "packages/ui/src/theme/**",
        "tooling/typescript/**",
        "package.json",
        "pnpm-workspace.yaml"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    // Density-artifact tripwires assert dist output; without the ui build they skip silently.
    "test": {
      "dependsOn": ["@elmeragroup/ui#build"]
    },
    "test:browser": {
      "dependsOn": ["build"]
    },
    "test:packed-consumer": {
      "dependsOn": ["pack"]
    },
    "test:types": {
      "dependsOn": ["build"]
    },
    "pack": {
      "dependsOn": ["build"],
      "outputs": [".artifacts/**"]
    },
    "package:check": {
      "dependsOn": ["pack"]
    },
    "size-limit": {
      "dependsOn": ["pack"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // Aggregate leaf. Every real gate below is its own task, so a package's own `ci:checks`
    // script has nothing left to run: `@elmeragroup/ui` defines it as a self-describing no-op
    // that exists only so `turbo run ci:checks` fans out to this dependency list.
    "ci:checks": {
      "dependsOn": [
        "//#lint",
        "//#test:repo-policy",
        "//#type-check:scripts",
        "type-check",
        "test",
        "test:browser",
        "test:packed-consumer",
        "test:types",
        "build",
        "package:check",
        "size-limit"
      ]
    }
  }
}
