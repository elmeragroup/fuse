{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "//#lint": {
      // apps/static-theme/vite.config.ts must import packages/ui/dist/theme.js (architecture.md:
      // colorSchemeScriptSource's Function#toString() has to be the packed IIFE, not re-emitted
      // TypeScript), and import/no-cycle resolves that import — so lint needs the ui build.
      "dependsOn": ["@elmeragroup/ui#build", "docs#generate"],
      "inputs": ["$TURBO_DEFAULT$", "tooling/oxlint-plugin/**", "tooling/oxlint-anti-slop/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "tooling/oxlint-plugin/**", "tooling/oxlint-anti-slop/**"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    // Density-artifact tripwires assert dist output; without the ui build they skip silently.
    "test": {
      "dependsOn": ["@elmeragroup/ui#build"]
    },
    "test:browser": {
      "dependsOn": ["build"]
    },
    "test:types": {
      "dependsOn": ["build"]
    },
    "test:shadow": {
      "dependsOn": ["build"]
    },
    "pack": {
      "dependsOn": ["build"],
      "outputs": [".artifacts/**"]
    },
    "package:check": {
      "dependsOn": ["pack"]
    },
    "size-limit": {
      "dependsOn": ["pack"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "ci:checks": {
      "dependsOn": [
        "//#lint",
        "type-check",
        "test",
        "test:browser",
        "test:types",
        "build",
        "package:check",
        "size-limit",
        "docs#test:shadow"
      ]
    }
  }
}
