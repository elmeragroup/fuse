{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "//#lint": {
      // apps/static-theme/vite.config.ts must import packages/ui/dist/theme.js (architecture.md:
      // colorSchemeScriptSource's Function#toString() has to be the packed IIFE, not re-emitted
      // TypeScript), and import/no-cycle resolves that import — so lint needs the ui build.
      "dependsOn": ["@elmeragroup/ui#build", "docs#generate"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#test:repo-policy": {
      "inputs": [
        "test/**",
        "plopfile.mjs",
        "plop-templates/**",
        "packages/ui/scripts/**",
        "packages/ui/package.json",
        "scripts/**",
        "packages/ui/src/icons/roster.ts",
        ".changeset/config.json",
        ".github/workflows/**",
        "package.json",
        ".oxlintrc.json",
        "turbo.json",
        "apps/docs/package.json",
        "pnpm-workspace.yaml"
      ]
    },
    "//#type-check:scripts": {
      "inputs": [
        "scripts/**",
        "packages/ui/scripts/**",
        "tooling/typescript/**",
        "package.json",
        "pnpm-workspace.yaml"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      // The release stamp reaches the UI build through the environment and changes the packed
      // manifest, so it belongs in the cache key whenever a build runs through turbo.
      "env": ["ELMERA_RELEASE_CHANNEL", "ELMERA_RELEASE_COMMIT", "ELMERA_RELEASE_VERSION"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    // Density-artifact tripwires assert dist output; without the ui build they skip silently.
    "test": {
      "dependsOn": ["@elmeragroup/ui#build"]
    },
    "test:browser": {
      "dependsOn": ["build"]
    },
    "test:packed-consumer": {
      "dependsOn": ["pack"]
    },
    "test:types": {
      "dependsOn": ["build"]
    },
    "pack": {
      "dependsOn": ["build"],
      "outputs": [".artifacts/**"]
    },
    "package:check": {
      "dependsOn": ["pack"]
    },
    "size-limit": {
      "dependsOn": ["pack"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // Aggregate leaf. Every real gate below is its own task, so a package's own `ci:checks`
    // script has nothing left to run: `@elmeragroup/ui` defines it as a self-describing no-op
    // that exists only so `turbo run ci:checks` fans out to this dependency list.
    "ci:checks": {
      "dependsOn": [
        "//#lint",
        "//#test:repo-policy",
        "//#type-check:scripts",
        "type-check",
        "test",
        "test:browser",
        "test:packed-consumer",
        "test:types",
        "build",
        "package:check",
        "size-limit"
      ]
    }
  }
}
