{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "//#lint": {
      // apps/static-theme/vite.config.ts must import packages/ui/dist/theme.js (architecture.md:
      // colorSchemeScriptSource's Function#toString() has to be the packed IIFE, not re-emitted
      // TypeScript), and import/no-cycle resolves that import — so lint needs the ui build.
      "dependsOn": ["@elmeragroup/ui#build", "docs#generate"],
      "inputs": ["$TURBO_DEFAULT$", "tooling/oxlint-plugin/**", "tooling/oxlint-anti-slop/**"]
    },
    "//#test:repo-policy": {
      "inputs": [
        "test/**",
        ".github/workflows/**",
        "package.json",
        ".oxlintrc.json",
        "turbo.json",
        "tooling/api-extractor/package.json"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "tooling/oxlint-plugin/**", "tooling/oxlint-anti-slop/**"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    // Density-artifact tripwires assert dist output; without the ui build they skip silently.
    "test": {
      "dependsOn": ["@elmeragroup/ui#build"]
    },
    "test:browser": {
      "dependsOn": ["build"]
    },
    "test:packed-consumer": {
      "dependsOn": ["pack"]
    },
    "test:types": {
      "dependsOn": ["build"]
    },
    "test:shadow": {
      "dependsOn": ["build"]
    },
    "pack": {
      "dependsOn": ["build"],
      "outputs": [".artifacts/**"]
    },
    "package:check": {
      "dependsOn": ["pack"]
    },
    "size-limit": {
      "dependsOn": ["pack"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // Aggregate leaf. Every real gate below is its own task, so a package's own `ci:checks`
    // script has nothing left to run: `@elmeragroup/ui` defines it as a self-describing no-op
    // that exists only so `turbo run ci:checks` fans out to this dependency list. Only
    // `@elmeragroup/api-extractor` has private gates of its own to run under the leaf.
    "@elmeragroup/api-extractor#ci:checks": {
      "dependsOn": ["build", "test", "type-check"]
    },
    "ci:checks": {
      "dependsOn": [
        "//#lint",
        "//#test:repo-policy",
        "type-check",
        "test",
        "test:browser",
        "test:packed-consumer",
        "test:types",
        "build",
        "package:check",
        "size-limit",
        "docs#test:shadow"
      ]
    }
  }
}
